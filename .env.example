# Back2You - Production-Quality Campus Lost & Found Platform
# Environment Configuration Template

# 1. Supabase Configuration (Leave blank or fill with actual Supabase project keys)
# Obtain these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Application Mode
# Set to 'true' to force offline demo mode with rich seed data even if Supabase keys exist
VITE_DEMO_MODE=false

# 3. Default Campus (Used when registering or testing without pre-selected campus)
VITE_DEFAULT_CAMPUS_CODE=SU-MAIN

# 4. Storage Bucket Configuration
VITE_STORAGE_BUCKET=item-images
